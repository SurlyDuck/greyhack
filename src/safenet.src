// Proxy network manager oRiG
// Layout of map files is as follows:

//22.131.15.150,user,password,
//_
//69.169.69.169,dummy_user,dummy_pass,



crypto = include_lib("/lib/crypto.so")
server_file_encrypt  = true
server_file_path     = "/home/ORIG/Config"

servers = {}
servers.addresses = []
servers.users     = []
servers.passwords = []
servers.status    = []

menus = {}
menus.title    = ["-- Main Menu --", "-- New server --", "-- Saving --", ""]
menus.options   = [ ["Load server file", "Add servers", "Save", "Quit"], [], [] ]
menus.selection = 0

safenet = {}
safenet.states = { 0:"main", 1:"new_server", 2:"save", 3:"exit" }
safenet.menu = 0

//------- Utilities -------

yorn = function(msg)
	answ = user_input(msg + " (y/n): ")
	return answ.upper().split(" ")[0] == "Y" or answ.upper().split(" ")[-1] == "Y"
end function
//------- End of utilities -------


safenet.check_connection = function(address, user, pwd)
	return typeof(get_shell().connect_service(address, 22, user, pwd)) == "shell"
end function

safenet.get_online_servers = function()
	online_servers = []
	if servers.addresses.len == 0 then return online_servers end if
	for server_id in range(servers.addresses.len()-1)
		if servers.status[server_id] then
			online_servers.push(servers.addresses[server_id])
		end if
	end for

	return online_servers
end function

safenet.set_new_state = function(state)
	safenet.menu = safenet.states.indexOf(state)
end function

safenet.updt = function()
	if safenet.menu == safenet.states.indexOf("main") then
		print("========= SafeNet v1.0.0 by oRiG =========", 1)
		print("Servers online/total: " + safenet.get_online_servers().len() + "/" + servers.addresses.len(), 1)
		print(menus.title[safenet.menu], 1)
		
		use_selected_option = false
		index = 0
		for option in menus.options[safenet.menu]
			if index == menus.selection then
				print("[*] " + option, 1)
			else
				print("[ ] " + option, 1)
			end if
			index = index + 1
		end for
		
		options_count = menus.options[safenet.menu].len()
		key = user_input("", false, true)
		if key == "DownArrow" then
			menus.selection = (menus.selection + 1) % options_count
		else if key == "UpArrow" then
			menus.selection = (((menus.selection - 1) % options_count) + options_count) % options_count
		else if key == "RightArrow" then
			use_selected_option = true
		end if
		
		if use_selected_option then
			if menus.options[safenet.menu][menus.selection] == "Quit" then
				safenet.menu = safenet.states.indexOf("exit")
			else if menus.options[safenet.menu][menus.selection] == "Add servers" then
				safenet.menu = safenet.states.indexOf("new_server")
				menus.selection = 0
			else if menus.options[safenet.menu][menus.selection] == "Save" then
				safenet.menu = safenet.states.indexOf("save")
				menus.selection = 0
			end if
		end if
		
	else if safenet.menu == safenet.states.indexOf("exit") then
		exit()
	else if safenet.menu == safenet.states.indexOf("new_server") then
		print(menus.title[safenet.menu], 1)
		print("Type <q> to cancel at any moment", 1)
		address = user_input("Address: ", false, false, false)
		if address == "q" or address == "Q" then return safenet.set_new_state("main") end if
		usr = user_input("User: ", false, false, false)
		if usr == "q" or usr == "Q" then return safenet.set_new_state("main") end if
		pass = user_input("Password: ", true, false, false)
		if pass == "q" or pass == "Q" then return safenet.set_new_state("main") end if
		
		if usr == "" or pass == "" or address == "" then
			if not yorn("Invalid parameters. Try again?") then return safenet.set_new_state("main") end if
		end if
		
		if not safenet.check_connection(address, usr, pass) then
			print("Couldn't reach server.")
			if not yorn("Try again?") then return safenet.set_new_state("main") end if
			return
		end if
	
		servers.addresses.push(address)
		servers.users.push(usr)
		servers.passwords.push(pass)
		servers.status.push(true)
		if not yorn("Server added successfully. Add a new one?") then return safenet.set_new_state("main") end if
	else if safenet.menu == safenet.states.indexOf("save") then
		print(menus.title[safenet.menu], 1)
		if safenet.get_online_servers().len == 0 then
			print("There are no valid servers to save. Add them first", 1)
			user_input("Press ENTER to continue", false, true, true)
			safenet.set_new_state("main")
			return 
		end if
		pass       = null
		encryption = yorn("Use encryption?")
		if encryption then pass = user_input("Encryption password:", true) end if
		
		get_shell().host_computer.touch(server_file_path, "map.srv")
		file = get_shell().host_computer.File(server_file_path + "/map.srv")
		if not file then 
			if not yorn("Couldn't create a server file. Try again?") then return safenet.set_new_state("main") end if
		end if
		
		file.set_content("")
		for server_id in range(servers.addresses.len()-1)
			file.set_content(file.get_content() + servers.addresses[server_id] + "," + servers.users[server_id] + "," + servers.passwords[server_id] + ",")
			if server_id != 0 then
				file.set_content(file.get_content() + "_")
			end if
		end for
	
		if encryption then
			crypto.encrypt(file.path, pass)
		end if
		
	else
		exit("Unreacheable")
	end if
end function

safenet.init = function()
	print("========= SafeNet v1.0.0 by oRiG =========", 1)
	print("Searching for server files")
	dir = get_shell().host_computer.File(server_file_path)
	config_file = null
	decrypted = false
	pass = null
	if dir.is_folder then
		for file in dir.get_files()
			if file.name.split("\.")[-1] == "srv" then
				config_file = file
				print("Found a server file!")
				if crypto.is_encrypted(file.path) then
					print("Server file is encrypted!")
					pass = user_input("File password:", true)
					result = crypto.decrypt(file.path, pass)
					if not result then
						print("Couldn't decrypt file: " + result)
						config_file = null
					end if
					decrypted = true
				end if
				break
			end if
		end for
	end if

	if not config_file then
		print("Couldn't load server file")
		user_input("Press ENTER to continue")
	else
		config_content = config_file.get_content().split("_")
		if config_file.get_content().len > 0 then
			for server in config_content
				fields = server.split(",")
				servers.addresses.push(fields[0])
				servers.users.push(fields[1])
				servers.passwords.push(fields[2])
				servers.status.push(false)
			end for
		
			if decrypted then
				crypto.encrypt(config_file.path, pass)
			end if
		end if
		
		print("Servers found: " + servers.addresses.len())
		
		if servers.addresses.len() > 0 then
			for id in range(servers.addresses.len()-1 )
				servers.status[id] = safenet.check_connection(servers.addresses[id], servers.users[id], servers.passwords[id])
				if servers.status[id] then
					print(servers.addresses[id] + " --> OK")
				else
					print(servers.addresses[id] + " --> Unreachable")
				end if
			end for
		end if
	
		user_input("Press ENTER to continue")
	end if
end function

safenet.main = function()
	safenet.init()
	while true
		safenet.updt()
	end while
end function

safenet.main()

