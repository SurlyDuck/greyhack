// Use different xploits

if params.len() < 4 then
	exit("Usage:: " + program_path.split("/")[-1] + " [ip_address] [port] [mem_address] [str] [opt]")
end if

xploit = include_lib("lib/metaxploit.so")
if not xploit then
	exit("Metaxploit.so not found")
end if

ip_address = params[0]
port = params[1].val()
mem_address = params[2]
str = params[3]
opt = null
if params.len >= 5 then
	opt = params[4]
end if

net_session = xploit.net_use(ip_address, port)
if not net_session then
	exit("Couldn't estabilish a net session, check the ip address and port")
end if

metalib = net_session.dump_lib()
print("lib loaded: " + metalib.lib_name + " " + metalib.version)

result = null
if not opt then
	result = metalib.overflow(mem_address, str)
else 
	print(opt)
	result = metalib.overflow(mem_address, str, opt)
end if 

// TODO: handle different results
// TODO: Use a REPL here and ask what the user wants to do instead of these standard actions
if not result then
	exit("failure")
else if typeof(result) == "computer" then 
	file = result.File("/etc/passwd")
	if file then
		print(file.get_content())
	end if
else if typeof(result) == "shell" then
	result.start_terminal()
end if

print("Returned: " + typeof(result))
